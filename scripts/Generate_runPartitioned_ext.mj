#!/usr/bin/env flour

import lists;

let final NT = 5;

fn mkIntentArgs(rwList: list<string>) -> string {
    let args = <string>[];

    for rw in rwList.enumerate() {
        let j = 1 + rw.0;
        args <- "${rw.1}PartIntent<T${j}> pi${j}";
    }

    args.join(",\n")
}

fn mkChunkTask(rwList: list<string>) -> string {
    let args = <string>[];

    for rw in rwList.enumerate() {
        let j = 1 + rw.0;
        args <- "${rw.1}PartListView<T${j}>";
    }

    let n = rwList.len();
    let argsStr = args.join(",\n");

    "PartTask${n}<\n${argsStr}, CompletableFuture<Void>> chunkTask"
}

fn mkVoidChunkTask(rwList: list<string>) -> string {
    let args = <string>[];

    for rw in rwList.enumerate() {
        let j = 1 + rw.0;
        args <- "${rw.1}PartListView<T${j}>";
    }

    let n = rwList.len();
    let argsStr = args.join(",\n");

    "VoidPartTask${n}<\n${argsStr}> chunkTask"
}

fn mkListInits(n: int) -> string {
    ["final var list${i} = pi${i}.getUnderlying();" | i in [1..=n]].join("\n")
}

fn mkViewInits(rwList: list<string>) -> string {
    (for rw in rwList.enumerate() {
        let j = rw.0 + 1;
        push ##
final var data${j} = list${j}.data;
final var dataSize${j} = data${j}.size();
final var lo${j} = partIndex(partNum, nChunks, dataSize${j}, nGhosts);
final var hi${j} = partIndex(partNum + 1, nChunks, dataSize${j}, nGhosts);
final var chunkSize${j} = hi${j} - lo${j};
final var view${j} = new ${rw.1}PartListView<>(data${j}, lo${j}, chunkSize${j}, nGhosts, partNum, list${j});
        ##;
    }).join("\n\n")
}

fn mkViewInits2(rwList: list<string>) -> string {
    (for rw in rwList.enumerate() {
        let j = rw.0 + 1;
        push ##
final var data${j} = list${j}.data;
final var lo${j} = ranges.getWritableBegin(partNum);
final var hi${j} = ranges.getWritableEnd(partNum);
final var chunkSize${j} = hi${j} - lo${j};
final var view${j} = new ${rw.1}PartListView<>(data${j}, lo${j}, chunkSize${j}, nGhosts, partNum, list${j});
        ##;
    }).join("\n\n")
}

fn mkCallInit(rwList: list<string>, factory: string) -> string {
    let listArgs = ["list${i}" | i in [1..=rwList.len()]].join(", ");
    let kindArgs = ["PartIntentKind.${rw}" | rw in rwList].join(", ");

    ##
final var call = PartCall.${factory}, nGhosts,
                                    new PartitionableList<?>[] {${listArgs}},
                                    new PartIntentKind[] {${kindArgs}}).withPartFutures();
    ##.trim()
}

fn mkRunPartedFutBodyWith(rwList: list<string>, callInit: string, viewInits: string) -> string {
    let viewList = ["view${i}" | i in [1..=rwList.len()]].join(", ");

    ##

// The call takes one range per list for all of its parts, admitted in guard order as runPartitioned's are
// (PartCall.java). The last part whose body returns releases them, before the parts' futures complete; the
// returned future completes when they are released and every part's future is complete.
${mkListInits(rwList.len())}

${callInit}

call.start((partNum) -> {
    CompletableFuture<Void> partFut;
    try {
        ${viewInits}

        partFut = Pool.callCapturing(() -> chunkTask.apply(${viewList}));
    } catch (Throwable e) {
        Pool.reportTaskFailure(e);
        partFut = CompletableFuture.failedFuture(e);
    }
    call.partDone(null);
    partFut.whenComplete((v, e) -> call.partFutureDone(e));
});

return call.future();

    ##.trim()
}

fn mkRunPartedFutBody(rwList: list<string>) -> string {
    mkRunPartedFutBodyWith(rwList, mkCallInit(rwList, "ofChunks(nChunks"), mkViewInits(rwList))
}

fn mkRunPartedFutBody2(rwList: list<string>) -> string {
    mkRunPartedFutBodyWith(rwList, mkCallInit(rwList, "ofRanges(ranges"), mkViewInits2(rwList))
}

fn emitRunParted(tpList: list<string>, rwList: list<string>) {
    let piList = ["pi${i}" | i in [1..=rwList.len()]].join(", ");
    let access = if rwList.contains("ReadWrite") {
        "private"
    } else {
        "public"
    };

    println(
        ##
/**
 * Runs chunkTask on nChunks parts of the lists, each returning a future. The call's ranges are released when the
 * last part's body returns, not when the returned futures complete. A part's returned future must not read or write
 * the part's views.
 */
public static <${tpList.join(', ')}> CompletableFuture<Void> runPartitionedFut(
    int nChunks,
    ${mkIntentArgs(rwList)},
    ${mkChunkTask(rwList)}
) {
    return runPartitionedFut(nChunks, 0, ${piList}, chunkTask);
}

        ##.trimMulti()
    );

    println(
        ##

${access} static <${tpList.join(', ')}> CompletableFuture<Void> runPartitionedFut(
    int nChunks, int nGhosts,
    ${mkIntentArgs(rwList)},
    ${mkChunkTask(rwList)}
) {
    ${mkRunPartedFutBody(rwList)}
}

        ##.trimMulti()
    );
    println("");

    println(
        ##
/**
 * Runs chunkTask on the parts of ranges (the call takes the hull of their writable ranges), each returning a future.
 * The call's ranges are released when the last part's body returns, not when the returned futures complete. A part's
 * returned future must not read or write the part's views.
 */
public static <${tpList.join(', ')}> CompletableFuture<Void> runPartitionedFut(
    PartitionRangeProvider ranges,
    ${mkIntentArgs(rwList)},
    ${mkChunkTask(rwList)}
) {
    return runPartitionedFut(ranges, 0, ${piList}, chunkTask);
}

        ##.trimMulti()
    );
    println("");

    println(
        ##

${access} static <${tpList.join(', ')}> CompletableFuture<Void> runPartitionedFut(
    PartitionRangeProvider ranges, int nGhosts,
    ${mkIntentArgs(rwList)},
    ${mkChunkTask(rwList)}
) {
    ${mkRunPartedFutBody2(rwList)}
}

        ##.trimMulti()
    );
    println("");
}

fn main() {
    println("// region Generated by Generate_runPartitioned_ext.mj");

    for i in [1..=NT] {
        let typeParams = ["T${t}" | t in [1..=i]];
        for j in [0..=i] {
            for k in [0..=(i-j)] {
                let rwList = ["ReadOnly"] * j + ["WriteOnly"] * k + ["ReadWrite"] * (i - j - k);
                for p in rwList.permutations().uniqueElements() {
                    emitRunParted(typeParams, p);
                }
            }

        }
    }

    println("// endregion");
}

main();
